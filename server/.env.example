PORT=5000
NODE_ENV=development

# Allowed CORS Origins (In production, set to your Netlify site URL)
# Multiple origins can be comma-separated: https://dtn-india-apply.netlify.app,http://localhost:5173
CLIENT_URL=https://dtn-india-apply.netlify.app

# Security & Authentication
JWT_SECRET=your_secure_jwt_secret_min_32_chars_here
JWT_EXPIRES_IN=24h

# Administrator Account Initial Credentials / Password Rotation
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dtnindia.com
ADMIN_PASSWORD=your_strong_admin_password_here
# Set to 'true' to force rotate the admin password upon restart:
# ADMIN_ROTATE_PASSWORD=false

# Database & Storage
DB_FILE=./data/dtn_application_portal.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880

# Payment Integration (simulated / razorpay_sandbox)
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
