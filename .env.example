# DTN INDIA CUSTOMER APPLICATION PORTAL CONFIGURATION
# Digital Telco Network India Pvt. Ltd.

PORT=5000
NODE_ENV=development

# Allowed CORS Origins for Backend (Set to your Netlify URL in production)
CLIENT_URL=https://dtn-india-apply.netlify.app

# Frontend Netlify Environment Variable (Netlify Dashboard > Site Configuration > Environment Variables)
# VITE_API_BASE_URL=https://dtn-customer-application-portal.onrender.com/api

# Security & Authentication
JWT_SECRET=your_jwt_secret_key_min_32_characters_here
JWT_EXPIRES_IN=24h

# Administrator Initial Credentials / Password Rotation
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@dtnindia.com
ADMIN_PASSWORD=your_strong_admin_password_here
# ADMIN_ROTATE_PASSWORD=false

# Database & Storage
DB_FILE=./data/dtn_application_portal.db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=5242880 # 5 MB

# Payment Integration (simulated / razorpay_sandbox)
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret


