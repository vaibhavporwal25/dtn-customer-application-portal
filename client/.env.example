# DTN INDIA FRONTEND CLIENT CONFIGURATION (.env)
# Digital Telco Network India Pvt. Ltd.

# Local Development API Endpoint (defaults to http://localhost:5000/api if omitted):
# VITE_API_BASE_URL=http://localhost:5000/api

# Production Netlify Deployment:
# In Netlify Dashboard > Site Configuration > Environment Variables:
# Key: VITE_API_BASE_URL
# Value: https://dtn-customer-application-portal.onrender.com/api
