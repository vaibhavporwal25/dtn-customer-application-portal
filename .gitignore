# ========================================================
# DTN India Application Portal — Git Ignore Configuration
# ========================================================

# Dependencies
node_modules/
**/node_modules/

# Production build artifacts
dist/
**/dist/
dist-ssr/
build/
.cache/

# Environment configurations and secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local SQLite databases, journals & backups
server/data/*.db
server/data/*.db-journal
server/data/*.sqlite
server/data/*.sqlite3
server/data/*.bak
server/data/*.backup
data/*.db
data/*.db-journal
data/*.sqlite
data/*.sqlite3
!server/data/.gitkeep
!data/.gitkeep

# Uploaded documents, KYC files & temporary test exports
server/uploads/*
uploads/*
!server/uploads/.gitkeep
!uploads/.gitkeep
*.xlsx

# Application and runtime logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Private keys, certificates and credentials
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt

# Operating system and editor artifacts
.DS_Store
Thumbs.db
desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json